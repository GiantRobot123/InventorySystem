
{
  "name": "mm-minimart-inventory",
  "version": "1.4.0",
  "description": "M&M Minimart Inventory Management System",
  "main": "electron-main.js",
  "author": "M&M Minimart",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder build --win --portable"
  },
  "build": {
    "appId": "com.mmminimart.inventory",
    "productName": "M&M Minimart",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!dist-electron/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
